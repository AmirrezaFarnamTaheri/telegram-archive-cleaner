# ==============================================================================
# Telegram Archive Cleaner - Environment Configuration
# ==============================================================================

# --- Telegram MTProto Credentials ---
# Obtain from https://my.telegram.org (under 'API development tools')
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_telegram_api_hash_here
TELEGRAM_PHONE=+1234567890
TELEGRAM_SESSION_NAME=cleaner_session

# --- Telegram Proxy / Relay Configuration (Optional) ---
# Use a SOCKS5, HTTP, or MTProxy relay to reduce local ISP latency and bypass blocks
# Supported types: socks5, http, mtproxy
TELEGRAM_PROXY_TYPE=
TELEGRAM_PROXY_HOST=
TELEGRAM_PROXY_PORT=
TELEGRAM_PROXY_USERNAME=
TELEGRAM_PROXY_PASSWORD=
TELEGRAM_PROXY_SECRET=

# --- Performance & Bandwidth Saver Mode ---
# When true, skips downloading media and restricts perceptual thumbnail hashing
DATA_SAVER_MODE=true

# --- Local Storage & Backup Paths ---
DB_PATH=data/cleaner.db
BACKUP_DIR=backups

# --- Web Dashboard Server Configuration ---
WEB_HOST=0.0.0.0
WEB_PORT=8000
API_TOKEN=

# --- Optional Semantic LLM Evaluation ---
# If provided, enables semantic detection of superseded messages in threads
GEMINI_API_KEY=
OPENAI_API_KEY=